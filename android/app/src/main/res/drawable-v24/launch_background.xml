<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24+ splash — supports android:gravity / android:width / android:height on <item>
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Deep diagonal gradient base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#020A1C"
                android:centerColor="#0B2C5D"
                android:endColor="#010516"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Centre radial blue glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#28063E99"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="40%"
                android:centerX="0.5"
                android:centerY="0.42" />
        </shape>
    </item>

    <!-- Layer 3: Subtle amber bottom accent glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#18F39C12"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="28%"
                android:centerX="0.5"
                android:centerY="0.76" />
        </shape>
    </item>

    <!-- Layer 4: Top amber accent stripe (fades at edges) -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00F39C12"
                android:centerColor="#CCF39C12"
                android:endColor="#00F39C12"
                android:angle="0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 5: Outer concentric ring (brand blue, semi-transparent) -->
    <item
        android:gravity="center"
        android:width="180dp"
        android:height="180dp">
        <shape android:shape="oval">
            <solid android:color="#08063E99" />
            <stroke
                android:width="1dp"
                android:color="#22063E99" />
        </shape>
    </item>

    <!-- Layer 6: Inner concentric ring (amber accent) -->
    <item
        android:gravity="center"
        android:width="110dp"
        android:height="110dp">
        <shape android:shape="oval">
            <solid android:color="#0C063E99" />
            <stroke
                android:width="1dp"
                android:color="#30F39C12" />
        </shape>
    </item>

    <!-- Layer 7: Centre brand dot (amber) -->
    <item
        android:gravity="center"
        android:width="18dp"
        android:height="18dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#F8B500"
                android:endColor="#E8850B"
                android:type="radial"
                android:gradientRadius="50%"
                android:centerX="0.35"
                android:centerY="0.35" />
        </shape>
    </item>

</layer-list>
